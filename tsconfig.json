{
  "compilerOptions": {
    "target": "ESNext",
    // General
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "module": "ESNext",
    "moduleResolution": "bundler",

    "types": ["vite/client"],
    // Type Checking & Safety
    "strict": true,

    "noEmit": true,
    // Modules
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true
  }
}
